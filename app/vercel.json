{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "env": [
    {
      "key": "MONGODB_URI",
      "description": "MongoDB Atlas connection string",
      "value": "",
      "type": "secret"
    },
    {
      "key": "JWT_SECRET",
      "description": "JWT secret key (min 32 characters)",
      "value": "",
      "type": "secret"
    },
    {
      "key": "COOKIE_SECURE",
      "description": "Enable secure cookies in production",
      "value": "true"
    },
    {
      "key": "COOKIE_SAME_SITE",
      "description": "SameSite cookie attribute",
      "value": "lax"
    }
  ],
  "regions": ["iad1"],
  "functions": {
    "app/api/**/*.js": {
      "maxDuration": 30
    }
  }
}
